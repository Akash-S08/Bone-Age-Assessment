{
    "model": {
        "backbone": "resnet34",
        "num_classes": 1,
        "attention_type": "cbam",
        "pretrained": true
    },
    "training": {
        "batch_size": 32,
        "learning_rate": 0.001,
        "epochs": 100,
        "early_stopping_patience": 30,
        "weight_decay": 1e-4,
        "device": "cuda",
        "num_workers": 4,
        "seed": 42
    },
    "data": {
        "image_size": 224,
        "mean": [0.485, 0.456, 0.406],
        "std": [0.229, 0.224, 0.225],
        "train_split": 0.8,
        "val_split": 0.2
    },
    "paths": {
        "data_dir": "../data",
        "model_dir": "../models",
        "log_dir": "../logs"
    }
}